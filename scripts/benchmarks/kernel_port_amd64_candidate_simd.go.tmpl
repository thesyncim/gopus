//go:build amd64 && goexperiment.simd && !nosimd

package celt

import "testing"

var kernelPortBenchAMD64Recip [4]float32

func BenchmarkPortAMD64PVQRcpApprox4(b *testing.B) {
	var src [kernelPortBenchAMD64Batch][4]float32
	var dst [kernelPortBenchAMD64Batch][4]float32
	for i := range src {
		for lane := range src[i] {
			src[i][lane] = float32((i*7+lane*13)%127+1) * 0.125
		}
	}
	b.ReportAllocs()
	iteration := 0
	for b.Loop() {
		slot := iteration & (kernelPortBenchAMD64Batch - 1)
		x86RcpApprox4(&dst[slot], &src[slot])
		iteration++
	}
	var result [4]float32
	for i := range dst {
		for lane := range dst[i] {
			result[lane] += dst[i][lane]
		}
	}
	kernelPortBenchAMD64Recip = result
}

func BenchmarkPortAMD64PVQBestID(b *testing.B) {
	const n = 48
	absX, y := kernelPortBenchAMD64PVQBestIDInputs(n)
	b.ReportAllocs()
	var ids [kernelPortBenchAMD64Batch]int
	iteration := 0
	for b.Loop() {
		slot := iteration & (kernelPortBenchAMD64Batch - 1)
		kernelPortBenchAMD64ID = x86PVQSearchBestIDSSE2(absX[slot], y[slot], 3.25, 9.5, n)
		ids[slot] = kernelPortBenchAMD64ID
		iteration++
	}
	var result int
	for _, id := range ids {
		result += id
	}
	kernelPortBenchAMD64ID = result
}
